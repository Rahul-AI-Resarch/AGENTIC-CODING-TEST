# ---- server ----
BAA_HOST=0.0.0.0
BAA_PORT=8000

# Where run data (SQLite + run folders) lives.
BAA_DATA_DIR=./data

# Serve the built React console from html/dist at "/".
BAA_SERVE_CONSOLE=true

# Comma-separated exact origins allowed to call the API.
# Add your GitHub Pages origin here, e.g. https://rahul-ai-resarch.github.io
BAA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- BYOK (bring your own key) ----
# Keys are read from the environment or posted per-run; they are never
# written to disk. Leave blank to use the console's own key dialog.
BAA_PROVIDER=openai
BAA_MODEL=gpt-4o
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- web search ----
# Optional. The keyless tier (You.com MCP ?profile=free) works without a key.
# Setting this unlocks the keyed Search API + higher rate limits + livecrawl.
YDC_API_KEY=
